# ── OS / Editor ────────────────────────────────────────────
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Runtime state (user-specific, regenerated on each run) ─
selected_ports.json
aliases.json
drone_tags.json
geofences.json
webhook_url.json
stations.json
meshtastic_config.json
adsb_config.json
cache_jobs.json

# ── Session detections / exports (per-run, contain positions) ─
detections_*.csv
detections_*.kml
cumulative_detections.csv
cumulative.kml
mapper.log
*.log

# ── Offline map tile cache (large, regenerable) ────────────
tiles/*.mbtiles
tiles/*.mbtiles-*
tiles/*-wal
tiles/*-shm

# ── Local secrets (just in case) ───────────────────────────
.env
.env.local
*.secret
*credentials*
